# Required for the Next.js app (use the same hosted Postgres/Neon connection your live site uses).
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Create a long, unique password for /admin. Never commit the real value.
ADMIN_PASSWORD="replace-with-a-long-unique-password"

# A random server-only secret used to sign admin and gallery sessions.
ADMIN_SESSION_SECRET="replace-with-at-least-32-random-characters"
GALLERY_SESSION_SECRET="replace-with-a-different-32-character-secret"
